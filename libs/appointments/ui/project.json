{
  "name": "appointments-ui",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "libs/appointments/ui/src",
  "prefix": "app",
  "tags": ["scope:appointments", "type:ui"],
  "targets": {
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "parallel": false,
        "commands": [
          "npx tsc -p libs/appointments/ui/tsconfig.lib.json --noEmit",
          "npx tsc -p libs/appointments/ui/tsconfig.spec.json --noEmit"
        ]
      }
    },
    "test": {
      "executor": "@nx/angular:unit-test",
      "options": {
        "buildTarget": "book:build:development",
        "tsConfig": "libs/appointments/ui/tsconfig.spec.json",
        "runner": "vitest",
        "include": ["libs/appointments/ui/src/**/*.spec.ts"],
        "watch": false
      },
      "configurations": {
        "watch": {
          "watch": true
        }
      }
    },
    "storybook": {
      "executor": "@storybook/angular-vite:start-storybook",
      "options": {
        "port": 4400,
        "configDir": "libs/appointments/ui/.storybook",
        "styles": ["apps/book/src/styles.css"]
      },
      "configurations": {
        "ci": {
          "quiet": true
        }
      }
    },
    "build-storybook": {
      "executor": "@storybook/angular-vite:build-storybook",
      "outputs": ["{options.outputDir}"],
      "options": {
        "outputDir": "dist/storybook/appointments-ui",
        "configDir": "libs/appointments/ui/.storybook",
        "styles": ["apps/book/src/styles.css"]
      },
      "configurations": {
        "ci": {
          "quiet": true
        }
      }
    }
  }
}
